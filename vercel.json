{
  "buildCommand": "git lfs pull && npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/video/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
